      state.timerCompletedForActiveDay[memberId] = activeDay;

      const dayPlan = READING_SCHEDULE[activeDay - 1] || READING_SCHEDULE[0];
      const session = {
        id: `sess_${Date.now()}`,
        member_id: memberId,
        member_name: state.activeMember.name,
        duration_seconds: 1200,
        language: state.readerLanguage === 'ta' ? 'Tamil' : 'English',
        book: `${dayPlan.otText} / ${dayPlan.ntText}`,
        completed_at: new Date().toISOString()
      };
      state.readingSessions.unshift(session);
      state.save();
      updateYouthDashboard();

      if (window.confetti) {
        window.confetti({ particleCount: 80, spread: 70, origin: { y: 0.6 }, colors: ['#496047', '#E5EBD9', '#B58B55'] });
      }
      playChime();
      openModal('modalTimerCelebration');
