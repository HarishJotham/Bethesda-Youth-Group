<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bethesda Youth Group - Growing Together in God's Word</title>
  <meta name="description" content="Complete Bilingual Bible Reading & 365-Day Youth Management Application with English & Tamil Bible, 20-min timer, and Supabase synchronization." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Noto+Sans+Tamil:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.4/dist/confetti.browser.min.js"></script>

  <style>
    :root {
      --bg-ivory: #FFF9EF;
      --bg-card: #F2E5D2;
      --sage-soft: #E5EBD9;
      --sage-mid: #9CB298;
      --sage-deep: #496047;
      --sage-deep-hover: #3A4E38;
      --accent-gold: #B58B55;
      --text-main: #49372F;
      --text-muted: #806B5B;
      --border-card: rgba(73, 55, 47, 0.12);
      --shadow-soft: 0 4px 20px -2px rgba(73, 55, 47, 0.08);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--bg-ivory);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      display: flex; flex-direction: column;
      line-height: 1.6;
    }
    h1, h2, h3, h4, .font-serif { font-family: 'Cormorant Garamond', Georgia, serif; }
    .font-tamil { font-family: 'Noto Sans Tamil', sans-serif; }
    .brand-title { font-family: 'Cinzel', serif; letter-spacing: 0.08em; }

    header {
      background: rgba(255, 249, 239, 0.95);
      backdrop-filter: blur(8px);
      border-bottom: 1.5px solid var(--border-card);
      position: sticky; top: 0; z-index: 40;
      padding: 0.75rem 1.25rem;
    }
    .header-inner {
      max-width: 1200px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    }
    .brand-crest {
      width: 40px; height: 40px; border-radius: 50%;
      background: var(--sage-deep); color: #FFF;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Cinzel', serif; font-weight: 700; font-size: 1.2rem;
      box-shadow: 0 2px 8px rgba(73, 96, 71, 0.25);
    }
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
      padding: 0.6rem 1.2rem; border-radius: 9999px;
      font-size: 0.9rem; font-weight: 600; cursor: pointer;
      transition: all 0.2s ease; border: 1.5px solid transparent;
      text-decoration: none; min-height: 44px;
    }
    .btn-sage { background: var(--sage-deep); color: #FFF; }
    .btn-sage:hover { background: var(--sage-deep-hover); transform: translateY(-1px); }
    .btn-gold { background: var(--accent-gold); color: #FFF; }
    .btn-gold:hover { background: #9E743F; }
    .btn-subtle { background: var(--bg-card); color: var(--text-main); border-color: var(--border-card); }
    .btn-subtle:hover { background: #E7D7C1; }
    .btn-outline { background: transparent; border-color: var(--sage-deep); color: var(--sage-deep); }
    .btn-outline:hover { background: var(--sage-soft); }

    .card {
      background: var(--bg-card);
      border-radius: 16px;
      border: 1px solid var(--border-card);
      box-shadow: var(--shadow-soft);
      padding: 1.5rem;
    }
    .card-ivory { background: #FFFDF9; }
    .card-sage-accent { border-left: 4px solid var(--sage-deep); }
    .badge {
      display: inline-flex; align-items: center; gap: 0.35rem;
      padding: 0.3rem 0.75rem; border-radius: 9999px;
      font-size: 0.78rem; font-weight: 600;
    }
    .badge-sage { background: var(--sage-soft); color: var(--sage-deep); }
    .badge-gold { background: #F8EFE0; color: #8F662F; }

    .screen-view { display: none; }
    .screen-view.active { display: block; animation: fadeIn 0.25s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

    .app-container { max-width: 1200px; margin: 0 auto; padding: 1.5rem 1.25rem; flex: 1; width: 100%; }
    .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .grid-members { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem; }

    /* Circular Timer */
    .timer-container {
      position: relative; width: 230px; height: 230px; margin: 0 auto 1.25rem;
      display: flex; align-items: center; justify-content: center;
    }
    .timer-svg { transform: rotate(-90deg); width: 100%; height: 100%; }
    .timer-bg-circle { fill: none; stroke: rgba(73, 96, 71, 0.15); stroke-width: 10; }
    .timer-bar {
      fill: none; stroke: var(--sage-deep); stroke-width: 10;
      stroke-linecap: round; transition: stroke-dashoffset 0.5s ease;
    }
    .timer-digits-box { position: absolute; text-align: center; }
    .timer-digits { font-family: 'Cinzel', serif; font-size: 3rem; font-weight: 700; color: var(--sage-deep); line-height: 1; }

    /* Verse highlight */
    .verse-row {
      padding: 0.75rem 0.5rem; border-radius: 8px; margin-bottom: 0.35rem;
      display: flex; gap: 0.75rem; align-items: baseline; cursor: pointer;
      transition: background 0.15s ease;
    }
    .verse-row:hover { background: rgba(73, 96, 71, 0.05); }
    .verse-highlight-sage { background: #EDF3E6 !important; border-left: 3px solid var(--sage-deep); }
    .verse-num { font-weight: 700; color: var(--accent-gold); min-width: 28px; font-size: 0.85rem; user-select: none; }

    /* Modals */
    .modal-backdrop {
      display: none; position: fixed; inset: 0; background: rgba(73, 55, 47, 0.45);
      backdrop-filter: blur(4px); z-index: 100;
      align-items: center; justify-content: center; padding: 1rem;
    }
    .modal-backdrop.open { display: flex; }
    .modal-box {
      background: var(--bg-ivory); border-radius: 20px;
      border: 1.5px solid var(--border-card); max-width: 540px; width: 100%;
      padding: 2rem; box-shadow: 0 20px 40px rgba(0,0,0,0.2); max-height: 90vh; overflow-y: auto;
    }
    .input-control {
      width: 100%; padding: 0.75rem 1rem; border-radius: 12px;
      border: 1.5px solid var(--border-card); background: #FFFDF9;
      font-size: 0.95rem; color: var(--text-main); outline: none;
    }
    .input-control:focus { border-color: var(--sage-deep); box-shadow: 0 0 0 3px rgba(73, 96, 71, 0.15); }
    .tab-btn {
      padding: 0.6rem 1.25rem; border: none; background: transparent;
      font-weight: 600; color: var(--text-muted); cursor: pointer;
      border-bottom: 2px solid transparent; transition: all 0.2s;
    }
    .tab-btn.active { color: var(--sage-deep); border-bottom-color: var(--sage-deep); }

    @media (max-width: 768px) {
      .grid-2, .grid-3 { grid-template-columns: 1fr; }
      .header-title-text { display: none; }
      .timer-container { width: 190px; height: 190px; }
      .timer-digits { font-size: 2.4rem; }
    }
  </style>
</head>
<body>

  <!-- Navigation Bar -->
  <header>
    <div class="header-inner">
      <div style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer;" id="navBrandLogo">
        <div class="brand-crest">B</div>
        <div>
          <div class="brand-title" style="font-weight: 700; font-size: 1.05rem; color: var(--sage-deep);">BETHESDA YOUTH</div>
          <div class="header-title-text" style="font-size: 0.72rem; color: var(--text-muted); font-style: italic;">Growing Together in God's Word</div>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 0.6rem;">
        <div id="navMemberSession" style="display: none; align-items: center; gap: 0.5rem; background: var(--bg-card); padding: 0.35rem 0.85rem; border-radius: 9999px;">
          <span style="font-size: 0.82rem; font-weight: 700; color: var(--sage-deep);" id="navMemberName">Youth</span>
          <button class="btn btn-subtle" id="navSwitchMemberBtn" style="padding: 0.2rem 0.5rem; min-height: 28px; font-size: 0.72rem;">Switch</button>
        </div>
        <button class="btn btn-subtle" id="navBibleReaderBtn" style="display: none; font-size: 0.8rem; padding: 0.45rem 0.85rem;">Bible</button>
        <button class="btn btn-subtle" id="navPlanBtn" style="display: none; font-size: 0.8rem; padding: 0.45rem 0.85rem;">365 Plan</button>
        <button class="btn btn-outline" id="navAdminBtn" style="font-size: 0.8rem; padding: 0.45rem 0.85rem;">Admin Login</button>
      </div>
    </div>
  </header>

  <main class="app-container">

    <!-- 1. WELCOME SCREEN -->
    <section id="screenWelcome" class="screen-view active" style="text-align: center; max-width: 760px; margin: 2rem auto;">
      <div class="brand-crest" style="width: 76px; height: 76px; font-size: 2.2rem; margin: 0 auto 1.25rem;">B</div>
      <h1 class="brand-title" style="font-size: 2.5rem; color: var(--sage-deep); margin-bottom: 0.4rem;">BETHESDA YOUTH GROUP</h1>
      <p style="font-size: 1.15rem; color: var(--text-muted); font-style: italic; margin-bottom: 1.5rem;">"Growing Together in God's Word"</p>

      <div class="card card-ivory" style="margin-bottom: 2rem; border-left: 4px solid var(--accent-gold); text-align: center;">
        <p class="font-serif" style="font-size: 1.4rem; font-style: italic; line-height: 1.5; color: var(--text-main);">
          "Your word is a lamp to my feet and a light to my path."
        </p>
        <div class="font-tamil" style="font-size: 1.05rem; color: var(--text-muted); margin-top: 0.4rem;">
          "உம்முடைய வசனம் என் கால்களுக்குத் தீபமும், என் பாதைக்கு வெளிச்சமுமாயிருக்கிறது."
        </div>
        <div style="font-size: 0.85rem; font-weight: 700; color: var(--accent-gold); margin-top: 0.5rem; text-transform: uppercase;">
          Psalm 119:105 · சங்கீதம் 119:105
        </div>
      </div>

      <div class="grid-2">
        <div class="card" style="text-align: center; cursor: pointer; border: 2px solid var(--sage-deep);" id="btnChooseYouthMode">
          <div style="font-size: 2.2rem; margin-bottom: 0.5rem;">📖</div>
          <h3 class="font-serif" style="font-size: 1.7rem; font-weight: 700; color: var(--sage-deep); margin-bottom: 0.35rem;">YOUTH MODE</h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1.2rem;">Select your name & start your 20-min daily reading. No password needed!</p>
          <button class="btn btn-sage" style="width: 100%;">Enter Youth Reading</button>
        </div>

        <div class="card" style="text-align: center; cursor: pointer;" id="btnChooseAdminMode">
          <div style="font-size: 2.2rem; margin-bottom: 0.5rem;">🛡️</div>
          <h3 class="font-serif" style="font-size: 1.7rem; font-weight: 700; color: var(--accent-gold); margin-bottom: 0.35rem;">ADMIN MODE</h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1.2rem;">Church leadership access to manage youth members, sync, and view logs.</p>
          <button class="btn btn-gold" style="width: 100%;">Administrator Login</button>
        </div>
      </div>
    </section>

    <!-- 2. YOUTH MEMBER SELECTION -->
    <section id="screenYouthSelect" class="screen-view" style="max-width: 860px; margin: 0 auto;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <button class="btn btn-subtle" id="btnBackFromSelect" style="padding: 0.35rem 0.75rem; font-size: 0.8rem; margin-bottom: 0.5rem;">← Back</button>
          <h2 class="font-serif" style="font-size: 2rem; color: var(--sage-deep);">Select Your Name</h2>
          <p style="font-size: 0.9rem; color: var(--text-muted);">Tap your name to begin your daily Bible reading journey.</p>
        </div>
        <div style="width: 260px;">
          <input type="text" id="memberSearchInput" class="input-control" placeholder="Search your name..." />
        </div>
      </div>

      <div class="grid-members" id="membersGrid"></div>
      
      <div id="selectedMemberSticky" style="display: none; margin-top: 1.5rem; background: var(--sage-soft); border: 2px solid var(--sage-deep); border-radius: 16px; padding: 1rem 1.5rem; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <div>
          <div style="font-size: 0.8rem; color: var(--sage-deep); font-weight: 700; text-transform: uppercase;">Ready to Read</div>
          <div style="font-size: 1.3rem; font-weight: 700; color: var(--text-main);" id="stickyMemberName">Member</div>
        </div>
        <button class="btn btn-sage" id="btnContinueWithMember" style="padding: 0.75rem 1.75rem; font-size: 1rem;">Continue to Reading →</button>
      </div>
    </section>

    <!-- 3. YOUTH DASHBOARD & 20-MIN TIMER -->
    <section id="screenYouthDashboard" class="screen-view">
      <div class="card card-ivory" style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; border-left: 5px solid var(--sage-deep);">
        <div>
          <span class="badge badge-sage">Bethesda Youth Group</span>
          <h2 class="font-serif" style="font-size: 2.2rem; margin-top: 0.2rem;">Welcome, <span id="dashMemberName" style="color: var(--sage-deep);">Youth</span>!</h2>
          <p style="font-size: 0.88rem; color: var(--text-muted);" id="dashCurrentDate">Today</p>
        </div>
        <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
          <button class="btn btn-sage" id="dashStartReadingBtn">Open Bible Reader</button>
          <button class="btn btn-subtle" id="dashViewFullPlanBtn">365-Day Plan</button>
          <button class="btn btn-subtle" id="dashViewSavedVersesBtn">Saved Verses</button>
        </div>
      </div>

      <div class="grid-2" style="margin-bottom: 1.5rem;">
        <!-- Left: 20-Minute Reading Timer -->
        <div class="card" style="text-align: center;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h3 class="font-serif" style="font-size: 1.4rem; font-weight: 700; color: var(--sage-deep);">Daily 20-Minute Timer</h3>
            <span class="badge badge-gold" id="timerStatusBadge">Ready</span>
          </div>

          <div class="timer-container">
            <svg class="timer-svg" viewBox="0 0 240 240">
              <circle class="timer-bg-circle" cx="120" cy="120" r="105"></circle>
              <circle id="timerBar" class="timer-bar" cx="120" cy="120" r="105"></circle>
            </svg>
            <div class="timer-digits-box">
              <div class="timer-digits" id="timerDigits">20:00</div>
              <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Goal: 20 Minutes</div>
            </div>
          </div>

          <div style="display: flex; justify-content: center; gap: 0.75rem;">
            <button class="btn btn-sage" id="btnTimerStart" style="padding: 0.65rem 1.75rem;">
              <span id="btnTimerStartLabel">Start Timer</span>
            </button>
            <button class="btn btn-subtle" id="btnTimerReset">Reset</button>
          </div>
          <p style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.75rem;">Timer runs even if you navigate into the Bible Reader!</p>
        </div>

        <!-- Right: Current Sequential Reading Plan Assignment & Anti-Cheating Lock -->
        <div class="card card-ivory" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span class="badge badge-sage" id="dashDayBadge">Day 1 of 365</span>
              <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">Sequential Plan</span>
            </div>
            <h3 class="font-serif" style="font-size: 1.6rem; color: var(--sage-deep); margin-bottom: 0.75rem;">Today's Assigned Scripture</h3>

            <div style="background: var(--bg-card); padding: 1rem; border-radius: 12px; margin-bottom: 0.75rem;">
              <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">Old Testament</div>
              <div style="font-size: 1.15rem; font-weight: 700; color: var(--text-main);" id="dashOTPassage">Genesis 1</div>
              <div class="font-tamil" style="font-size: 0.95rem; color: var(--sage-deep);" id="dashOTPassageTamil">ஆதியாகமம் 1</div>
              <div style="margin-top: 0.5rem; display: flex; gap: 0.5rem;">
                <button class="btn btn-subtle" id="dashReadOTEnglishBtn" style="padding: 0.25rem 0.65rem; font-size: 0.75rem; min-height: 32px;">Read English</button>
                <button class="btn btn-subtle font-tamil" id="dashReadOTTamilBtn" style="padding: 0.25rem 0.65rem; font-size: 0.75rem; min-height: 32px;">தமிழில்</button>
              </div>
            </div>

            <div style="background: var(--bg-card); padding: 1rem; border-radius: 12px; margin-bottom: 1rem;">
              <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">New Testament</div>
              <div style="font-size: 1.15rem; font-weight: 700; color: var(--text-main);" id="dashNTPassage">Matthew 1</div>
              <div class="font-tamil" style="font-size: 0.95rem; color: var(--sage-deep);" id="dashNTPassageTamil">மத்தேயு 1</div>
              <div style="margin-top: 0.5rem; display: flex; gap: 0.5rem;">
                <button class="btn btn-subtle" id="dashReadNTEnglishBtn" style="padding: 0.25rem 0.65rem; font-size: 0.75rem; min-height: 32px;">Read English</button>
                <button class="btn btn-subtle font-tamil" id="dashReadNTTamilBtn" style="padding: 0.25rem 0.65rem; font-size: 0.75rem; min-height: 32px;">தமிழில்</button>
              </div>
            </div>
          </div>

          <!-- Anti-Cheating Lock Container -->
          <div>
            <div id="planLockedNotice" style="padding: 1rem; border-radius: 12px; background: rgba(73, 96, 71, 0.08); border: 1.5px dashed var(--sage-deep); text-align: center;">
              <div style="color: var(--sage-deep); font-weight: 700; font-size: 0.95rem;">🔒 20-Minute Reading Required</div>
              <p style="font-size: 0.82rem; color: var(--text-muted); margin-top: 0.35rem;">
                You must complete your 20-minute Bible reading timer before this day's reading can be marked as complete.
              </p>
            </div>

            <div id="planUnlockedSuccess" style="display: none; padding: 0.85rem; border-radius: 12px; background: var(--sage-soft); border: 1.5px solid var(--sage-deep); text-align: center; margin-bottom: 0.75rem;">
              <span style="color: var(--sage-deep); font-weight: 700; font-size: 0.9rem;">
                ★ 20-Minute Reading Finished! You can now mark this reading complete.
              </span>
            </div>

            <button class="btn btn-sage" id="dashMarkPlanCompleteBtn" style="display: none; width: 100%; padding: 0.85rem; box-shadow: 0 4px 14px rgba(73, 96, 71, 0.35);">
              <span id="dashMarkPlanCompleteLabel">✓ Mark Day Complete & Advance</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Stats Row -->
      <div class="grid-3">
        <div class="card card-ivory" style="text-align: center;">
          <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">365-Day Progress</div>
          <div style="font-size: 2.2rem; font-weight: 700; color: var(--sage-deep); margin: 0.2rem 0;" id="statDaysCompleted">0 / 365</div>
          <div style="font-size: 0.82rem; color: var(--text-muted);" id="statPercentCompleted">0% Complete</div>
        </div>
        <div class="card card-ivory" style="text-align: center;">
          <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">20-Min Sessions</div>
          <div style="font-size: 2.2rem; font-weight: 700; color: var(--accent-gold); margin: 0.2rem 0;" id="statSessionsCount">0</div>
          <div style="font-size: 0.82rem; color: var(--text-muted);" id="statTotalMinutes">0 Total Minutes</div>
        </div>
        <div class="card card-ivory" style="text-align: center;">
          <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">Saved Verses</div>
          <div style="font-size: 2.2rem; font-weight: 700; color: var(--sage-deep); margin: 0.2rem 0;" id="statBookmarksCount">0</div>
          <div style="font-size: 0.82rem; color: var(--text-muted);">Highlighted passages</div>
        </div>
      </div>
    </section>

    <!-- 4. BILINGUAL BIBLE READER -->
    <section id="screenBibleReader" class="screen-view" style="max-width: 900px; margin: 0 auto;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.75rem;">
        <button class="btn btn-subtle" id="readerBackToDashBtn" style="padding: 0.4rem 0.85rem; font-size: 0.82rem;">← Back to Dashboard</button>
        <div style="display: flex; background: var(--bg-card); border-radius: 9999px; padding: 0.25rem;">
          <button class="tab-btn active" id="tabLangEnglish">English Bible</button>
          <button class="tab-btn font-tamil" id="tabLangTamil">தமிழ் வேதாகமம்</button>
        </div>
        <div style="display: flex; align-items: center; gap: 0.4rem;">
          <span style="font-size: 0.78rem; color: var(--text-muted);">Font:</span>
          <button class="btn btn-subtle" id="btnFontSmaller" style="padding: 0.2rem 0.5rem; min-height: 32px;">A-</button>
          <button class="btn btn-subtle" id="btnFontLarger" style="padding: 0.2rem 0.5rem; min-height: 32px;">A+</button>
        </div>
      </div>

