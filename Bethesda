    // Sequential 365-Day Plan Generator
    function generate365Schedule() {
      const schedule = [];
      let otBookIdx = 0, otCh = 1, ntBookIdx = 39, ntCh = 1;

      for (let day = 1; day <= 365; day++) {
        const otBook = BIBLE_BOOKS[otBookIdx];
        const otStart = otCh;
        const count = (day % 3 === 0) ? 3 : 2;
        let otEnd = Math.min(otStart + count - 1, otBook.chapters);
        otCh = otEnd + 1;
        if (otCh > otBook.chapters && otBookIdx < 38) { otBookIdx++; otCh = 1; }

        const otText = (otStart === otEnd) ? `${otBook.name} ${otStart}` : `${otBook.name} ${otStart}-${otEnd}`;
        const otTextTamil = (otStart === otEnd) ? `${otBook.tamil} ${otStart}` : `${otBook.tamil} ${otStart}-${otEnd}`;

        const ntBook = BIBLE_BOOKS[ntBookIdx];
        const currentNtCh = ntCh;
        const ntText = `${ntBook.name} ${currentNtCh}`;
        const ntTextTamil = `${ntBook.tamil} ${currentNtCh}`;
        ntCh++;
        if (ntCh > ntBook.chapters) {
          if (ntBookIdx < 65) { ntBookIdx++; ntCh = 1; }
          else { ntBookIdx = 18; ntCh = 1; } // wrap to Psalms
        }

        schedule.push({
          day, otText, otTextTamil, otBookName: otBook.name, otChapter: otStart,
          ntText, ntTextTamil, ntBookName: ntBook.name, ntChapter: currentNtCh
        });
      }
      return schedule;
    }
