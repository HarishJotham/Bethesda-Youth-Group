    });

    document.getElementById('dashStartReadingBtn').addEventListener('click', () => { renderScripture(); navigateTo('screenBibleReader'); });
    document.getElementById('navBibleReaderBtn').addEventListener('click', () => { renderScripture(); navigateTo('screenBibleReader'); });
    document.getElementById('dashViewFullPlanBtn').addEventListener('click', () => { renderReadingPlanList('all'); navigateTo('screenReadingPlan'); });
    document.getElementById('navPlanBtn').addEventListener('click', () => { renderReadingPlanList('all'); navigateTo('screenReadingPlan'); });
    document.getElementById('dashViewSavedVersesBtn').addEventListener('click', () => { renderSavedVerses(); navigateTo('screenSavedVerses'); });
    document.getElementById('readerBackToDashBtn').addEventListener('click', () => navigateTo('screenYouthDashboard'));
    document.getElementById('planBackToDashBtn').addEventListener('click', () => navigateTo('screenYouthDashboard'));
    document.getElementById('savedBackToDashBtn').addEventListener('click', () => navigateTo('screenYouthDashboard'));

    // Screen 4: Bilingual Bible Reader
    function renderScripture() {
      const isTa = state.readerLanguage === 'ta';
      document.getElementById('tabLangEnglish').className = `tab-btn ${!isTa ? 'active' : ''}`;
      document.getElementById('tabLangTamil').className = `tab-btn ${isTa ? 'active' : ''}`;

      document.getElementById('readerBookTitle').textContent = `${state.currentBook.name} ${state.currentChapter}`;
      document.getElementById('readerBookTitleTamil').textContent = `${state.currentBook.tamil} ${state.currentChapter}`;
      document.getElementById('currentBookChapterBtnLabel').textContent = isTa
        ? `${state.currentBook.tamil} ${state.currentChapter}`
        : `${state.currentBook.name} ${state.currentChapter}`;

      document.getElementById('readerTranslationBadge').textContent = isTa
        ? 'தமிழ் வேதாகமம் (BSI Authorized Public Domain)'
        : 'World English Bible / KJV Public Domain';

      const container = document.getElementById('verseList');
      container.style.fontSize = `${state.readerFontSize}px`;
      container.innerHTML = '';

      const key = `${state.currentBook.name}_${state.currentChapter}`;
      let verses = (SCRIPTURE_DATABASE[key]) ? (isTa ? SCRIPTURE_DATABASE[key].ta : SCRIPTURE_DATABASE[key].en) : null;

      if (!verses) {
        verses = [];
        for (let v = 1; v <= 12; v++) {
          verses.push(isTa
            ? `கர்த்தரின் பரிசுத்த வார்த்தை — ${state.currentBook.tamil} ${state.currentChapter}:${v}. அவருடைய கிருபை என்றென்றைக்குமுள்ளது.`
            : `The word of the Lord in ${state.currentBook.name} ${state.currentChapter}:${v}. His steadfast love endures forever.`);
        }
      }

      verses.forEach((text, i) => {
        const vNum = i + 1;
        const row = document.createElement('div');
        row.className = `verse-row ${isTa ? 'font-tamil' : 'font-serif'}`;
        const isSaved = state.bookmarks.find(b => b.member_id === state.activeMember?.id && b.book === state.currentBook.name && b.chapter === state.currentChapter && b.verse_num === vNum);
        if (isSaved) row.classList.add('verse-highlight-sage');

        row.innerHTML = `<span class="verse-num">${vNum}</span><span>${text}</span>`;
        row.addEventListener('click', () => toggleHighlight(state.currentBook.name, state.currentChapter, vNum, text));
        container.appendChild(row);
      });
    }

    function toggleHighlight(book, ch, vNum, text) {
      if (!state.activeMember) return;
      const mId = state.activeMember.id;
      const idx = state.bookmarks.findIndex(b => b.member_id === mId && b.book === book && b.chapter === ch && b.verse_num === vNum);
      if (idx !== -1) state.bookmarks.splice(idx, 1);
      else state.bookmarks.push({ id: `bm_${Date.now()}`, member_id: mId, book, chapter: ch, verse_num: vNum, text, language: state.readerLanguage });
      state.save();
      renderScripture();
    }

    document.getElementById('tabLangEnglish').addEventListener('click', () => { state.readerLanguage = 'en'; renderScripture(); });
    document.getElementById('tabLangTamil').addEventListener('click', () => { state.readerLanguage = 'ta'; renderScripture(); });
    document.getElementById('btnFontSmaller').addEventListener('click', () => { state.readerFontSize = Math.max(14, state.readerFontSize - 2); renderScripture(); });
    document.getElementById('btnFontLarger').addEventListener('click', () => { state.readerFontSize = Math.min(28, state.readerFontSize + 2); renderScripture(); });

    document.getElementById('btnPrevChapter').addEventListener('click', () => {
      if (state.currentChapter > 1) state.currentChapter--;
      else {
        const idx = BIBLE_BOOKS.findIndex(b => b.id === state.currentBook.id);
        if (idx > 0) { state.currentBook = BIBLE_BOOKS[idx - 1]; state.currentChapter = state.currentBook.chapters; }
      }
      renderScripture();
    });

    document.getElementById('btnNextChapter').addEventListener('click', () => {
      if (state.currentChapter < state.currentBook.chapters) state.currentChapter++;
      else {
        const idx = BIBLE_BOOKS.findIndex(b => b.id === state.currentBook.id);
        if (idx < BIBLE_BOOKS.length - 1) { state.currentBook = BIBLE_BOOKS[idx + 1]; state.currentChapter = 1; }
      }
      renderScripture();
    });

    // Book & Chapter Picker
    let pickerSelectedBook = BIBLE_BOOKS[0];
    document.getElementById('btnBookSelectorModal').addEventListener('click', () => {
      openModal('modalBibleBookSelector');
      renderBookList('OT');
    });
    document.getElementById('btnCloseBookModal').addEventListener('click', () => closeModal('modalBibleBookSelector'));

    document.getElementById('tabTestamentOT').addEventListener('click', () => {
      document.getElementById('tabTestamentOT').classList.add('active');
      document.getElementById('tabTestamentNT').classList.remove('active');
      renderBookList('OT');
    });
    document.getElementById('tabTestamentNT').addEventListener('click', () => {
      document.getElementById('tabTestamentNT').classList.add('active');
      document.getElementById('tabTestamentOT').classList.remove('active');
      renderBookList('NT');
    });

    function renderBookList(testament) {
      const container = document.getElementById('bookListContainer');
      container.innerHTML = '';
      const books = BIBLE_BOOKS.filter(b => b.testament === testament);
      books.forEach(b => {
        const btn = document.createElement('button');
        btn.className = `btn btn-subtle ${pickerSelectedBook.id === b.id ? 'btn-sage' : ''}`;
        btn.style.cssText = 'padding: 0.4rem; font-size: 0.76rem; text-align: left; justify-content: flex-start;';
        btn.innerHTML = `<div><div style="font-weight:700;">${b.name}</div><div class="font-tamil" style="font-size:0.7rem; opacity:0.85;">${b.tamil}</div></div>`;
        btn.addEventListener('click', () => {
          pickerSelectedBook = b;
          renderBookList(testament);
          renderChapterGrid(b);
        });
        container.appendChild(btn);
      });
      renderChapterGrid(pickerSelectedBook);
    }

    function renderChapterGrid(book) {
      document.getElementById('chapterPickerTitle').textContent = `Chapters (${book.name} - ${book.chapters})`;
      const grid = document.getElementById('chapterGrid');
      grid.innerHTML = '';
      for (let ch = 1; ch <= book.chapters; ch++) {
        const btn = document.createElement('button');
        btn.className = `btn btn-subtle ${state.currentBook.id === book.id && state.currentChapter === ch ? 'btn-sage' : ''}`;
        btn.style.cssText = 'padding: 0.35rem; font-size: 0.8rem;';
        btn.textContent = ch;
        btn.addEventListener('click', () => {
          state.currentBook = book;
          state.currentChapter = ch;
          closeModal('modalBibleBookSelector');
          renderScripture();
        });
        grid.appendChild(btn);
      }
    }

    // Screen 5: 365-Day Plan List
    function renderReadingPlanList(filter = 'all') {
      const container = document.getElementById('planDaysContainer');
      container.innerHTML = '';
      const mId = state.activeMember?.id;
      const memberPlans = state.planProgress[mId] || [];
      const activeDay = getMemberCurrentDay(mId);
      const isTimerDone = state.timerCompletedForActiveDay && (state.timerCompletedForActiveDay[mId] === activeDay);

      let list = READING_SCHEDULE;
      if (filter === 'pending') list = list.filter(d => !memberPlans.includes(d.day));
      if (filter === 'completed') list = list.filter(d => memberPlans.includes(d.day));

      list.forEach(item => {
        const isDone = memberPlans.includes(item.day);
        const isCurrent = (item.day === activeDay) && !isDone;
        const card = document.createElement('div');
        card.className = `card card-ivory ${isDone ? 'card-sage-accent' : ''}`;
        card.style.cssText = `padding: 1rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; ${isCurrent ? 'border: 2px solid var(--sage-deep); background: #F9FCF7;' : ''}`;

        let actionHtml = '';
        if (isDone) {
          actionHtml = '<span class="badge badge-sage">✓ Completed</span>';
        } else if (isCurrent) {
          actionHtml = isTimerDone
            ? `<button class="btn btn-sage" style="font-size: 0.76rem; padding: 0.35rem 0.75rem;" onclick="window.completeDayPlan(${item.day})">✓ Mark Day ${item.day} Complete</button>`
            : '<span style="font-size: 0.75rem; color: var(--sage-deep); font-weight: 600; background: var(--sage-soft); padding: 0.35rem 0.65rem; border-radius: 9999px;">🔒 20-min reading required</span>';
        } else {
          actionHtml = `<span style="font-size: 0.75rem; color: var(--text-muted); opacity: 0.75;">🔒 Locked (Day ${item.day - 1} first)</span>`;
        }

        card.innerHTML = `
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div class="brand-crest" style="width: 38px; height: 38px; font-size: 0.85rem; border-radius: 10px; background: ${isDone ? 'var(--sage-soft)' : (isCurrent ? 'var(--sage-deep)' : 'var(--bg-card)')}; color: ${isDone ? 'var(--sage-deep)' : (isCurrent ? '#FFF' : 'var(--text-main)')};">${item.day}</div>
            <div>
              <div style="font-size: 0.72rem; color: var(--text-muted); font-weight: 700;">${isCurrent ? '★ Current Plan' : `Day ${item.day}`}</div>
              <div style="font-weight: 700; font-size: 0.95rem;">${item.otText} · ${item.ntText}</div>
              <div class="font-tamil" style="font-size: 0.8rem; color: var(--text-muted);">${item.otTextTamil} · ${item.ntTextTamil}</div>
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
            <button class="btn btn-subtle" style="font-size: 0.74rem; padding: 0.3rem 0.65rem; min-height: 32px;" onclick="window.readOT('${item.otBookName}', ${item.otChapter})">Read OT</button>
            <button class="btn btn-subtle" style="font-size: 0.74rem; padding: 0.3rem 0.65rem; min-height: 32px;" onclick="window.readNT('${item.ntBookName}', ${item.ntChapter})">Read NT</button>
            ${actionHtml}
          </div>
        `;
        container.appendChild(card);
      });
    }

    window.readOT = (b, ch) => openReaderForPassage(b, ch, state.readerLanguage);
    window.readNT = (b, ch) => openReaderForPassage(b, ch, state.readerLanguage);
    window.completeDayPlan = function(dNum) {
      const mId = state.activeMember?.id;
      const activeDay = getMemberCurrentDay(mId);
      if (dNum !== activeDay || !state.timerCompletedForActiveDay || state.timerCompletedForActiveDay[mId] !== activeDay) {
        alert(`Please complete the 20-minute Bible reading timer before marking Day ${activeDay} as complete.`);
        return;
      }
      if (!state.planProgress[mId]) state.planProgress[mId] = [];
      if (!state.planProgress[mId].includes(dNum)) state.planProgress[mId].push(dNum);
      delete state.timerCompletedForActiveDay[mId];
      resetTimer();
      state.save();
      if (window.confetti) window.confetti({ particleCount: 60, spread: 60, origin: { y: 0.7 } });
      renderReadingPlanList();
      updateYouthDashboard();
    };

    document.getElementById('planFilterAll').addEventListener('click', () => {
      document.querySelectorAll('#screenReadingPlan .tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById('planFilterAll').classList.add('active');
      renderReadingPlanList('all');
    });
    document.getElementById('planFilterPending').addEventListener('click', () => {
      document.querySelectorAll('#screenReadingPlan .tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById('planFilterPending').classList.add('active');
      renderReadingPlanList('pending');
    });
    document.getElementById('planFilterDone').addEventListener('click', () => {
      document.querySelectorAll('#screenReadingPlan .tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById('planFilterDone').classList.add('active');
      renderReadingPlanList('completed');
    });

    // Screen 6: Saved Verses
    function renderSavedVerses() {
      const container = document.getElementById('savedVersesList');
      container.innerHTML = '';
      const list = state.bookmarks.filter(b => b.member_id === state.activeMember?.id);
      if (list.length === 0) {
        container.innerHTML = '<div style="text-align: center; color: var(--text-muted); padding: 3rem;">No saved verses yet. Tap any verse while reading to highlight it!</div>';
        return;
      }
      list.forEach(b => {
        const item = document.createElement('div');
        item.className = 'card card-ivory';
        item.innerHTML = `
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;">
            <div>
              <div style="font-weight: 700; color: var(--sage-deep); font-size: 1.05rem; margin-bottom: 0.35rem;">${b.book} ${b.chapter}:${b.verse_num}</div>
              <p class="${b.language === 'ta' ? 'font-tamil' : 'font-serif'}" style="font-size: 1.05rem; color: var(--text-main);">${b.text}</p>
            </div>
            <button class="btn btn-subtle" style="font-size: 0.72rem; padding: 0.25rem 0.5rem; min-height: 28px;" onclick="window.removeBookmark('${b.id}')">Remove</button>
          </div>
        `;
        container.appendChild(item);
      });
    }
    window.removeBookmark = function(id) {
      state.bookmarks = state.bookmarks.filter(b => b.id !== id);
      state.save();
      renderSavedVerses();
    };

    // Screen 7: Admin Panel
    document.getElementById('formAdminLogin').addEventListener('submit', (e) => {
      e.preventDefault();
      const val = document.getElementById('inputAdminPassword').value.trim();
      if (val === state.adminPin) {
        closeModal('modalAdminLogin');
        document.getElementById('inputAdminPassword').value = '';
        updateAdminDashboard();
        navigateTo('screenAdminDashboard');
      } else {
        alert("Incorrect Admin password. Please check with church leadership.");
      }
    });
    document.getElementById('btnCloseAdminModal').addEventListener('click', () => closeModal('modalAdminLogin'));
    document.getElementById('btnAdminLogout').addEventListener('click', () => navigateTo('screenWelcome'));

    function updateAdminDashboard() {
      const total = state.members.length;
      document.getElementById('adminMetricTotalMembers').textContent = total;
      document.getElementById('adminMetricTotalSessions').textContent = state.readingSessions.length;
      document.getElementById('adminMetricTotalMinutes').textContent = state.readingSessions.length * 20;

      const tbody = document.getElementById('adminMembersTableBody');
      tbody.innerHTML = '';
      state.members.forEach(m => {
        const count = state.readingSessions.filter(s => s.member_id === m.id).length;
        const plans = state.planProgress[m.id] || [];
        const tr = document.createElement('tr');
        tr.style.cssText = 'border-bottom: 1px solid var(--border-card);';
        tr.innerHTML = `
          <td style="padding: 0.65rem; font-weight: 700;">${m.name}</td>
          <td style="padding: 0.65rem; color: var(--text-muted);">${m.phone || '-'}</td>
          <td style="padding: 0.65rem;">${count}</td>
          <td style="padding: 0.65rem;">${plans.length} / 365</td>
          <td style="padding: 0.65rem;"><span class="badge ${m.status === 'active' ? 'badge-sage' : 'badge-gold'}">${m.status}</span></td>
          <td style="padding: 0.65rem; text-align: right;">
            <button class="btn btn-subtle" style="padding: 0.25rem 0.5rem; min-height: 28px; font-size: 0.72rem;" onclick="window.toggleMemberStatus('${m.id}')">${m.status === 'active' ? 'Deactivate' : 'Activate'}</button>
            <button class="btn btn-subtle" style="padding: 0.25rem 0.5rem; min-height: 28px; font-size: 0.72rem; color: #B33;" onclick="window.deleteMember('${m.id}')">Delete</button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      document.getElementById('cfgSupabaseUrl').value = state.supabaseUrl;
      document.getElementById('cfgSupabaseKey').value = state.supabaseKey;
    }

    window.toggleMemberStatus = function(id) {
      const m = state.members.find(x => x.id === id);
      if (m) { m.status = m.status === 'active' ? 'inactive' : 'active'; state.save(); updateAdminDashboard(); }
    };
    window.deleteMember = function(id) {
      if (confirm("Are you sure you want to delete this member?")) {
        state.members = state.members.filter(x => x.id !== id);
        state.save();
        updateAdminDashboard();
      }
    };

    // Add Member
    document.getElementById('btnAdminAddMember').addEventListener('click', () => {
      document.getElementById('inputMemberId').value = '';
      document.getElementById('inputMemberName').value = '';
      document.getElementById('inputMemberPhone').value = '';
      openModal('modalMemberForm');
    });
    document.getElementById('btnCloseMemberModal').addEventListener('click', () => closeModal('modalMemberForm'));
    document.getElementById('formMember').addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('inputMemberName').value.trim();
      const phone = document.getElementById('inputMemberPhone').value.trim();
      state.members.push({ id: `mem_${Date.now()}`, name, phone, status: 'active' });
      state.save();
      closeModal('modalMemberForm');
      updateAdminDashboard();
    });

    // CSV Export
    document.getElementById('btnAdminExportCSV').addEventListener('click', () => {
      let csv = "Session ID,Member Name,Passage Read,Language,Duration Minutes,Date & Time\n";
      state.readingSessions.forEach(s => {
        csv += `"${s.id}","${s.member_name}","${s.book}","${s.language}",20,"${s.completed_at}"\n`;
      });
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `bethesda_youth_reading_logs_${new Date().toISOString().split('T')[0]}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });

    // Supabase Config Save
    document.getElementById('btnSaveSupabaseConfig').addEventListener('click', () => {
      const url = document.getElementById('cfgSupabaseUrl').value.trim();
      const key = document.getElementById('cfgSupabaseKey').value.trim();
      state.supabaseUrl = url;
      state.supabaseKey = key;
      localStorage.setItem('byg_supabase_url', url);
      localStorage.setItem('byg_supabase_key', key);
      state.initSupabase();
      alert("Supabase settings saved and synchronization active!");
    });

    // Initial Screen Check
    if (state.activeMember) {
      updateYouthDashboard();
      navigateTo('screenYouthDashboard');
    } else {
      navigateTo('screenWelcome');
    }
  </script>
</body>
</html>
